# ─────────────────────────────────────────────
#  Globe Selfbot — Environment Configuration
# ─────────────────────────────────────────────

# Your Discord user token (required)
# Find it in DevTools → Application → Local Storage → token
DISCORD_TOKEN=your_token_here

# Command prefix (default: g.)
PREFIX=g.

# Bot owner ID (your Discord user ID)
OWNER_ID=your_user_id_here

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Anti-detection: randomize typing delays (ms range)
TYPING_DELAY_MIN=300
TYPING_DELAY_MAX=1200

# Auto-delete responses after N seconds (0 = disabled)
AUTO_DELETE_DELAY=0

# Nitro sniper (true/false)
NITRO_SNIPER=false

# AFK mode default message
AFK_MESSAGE=I'm AFK right now.
